# 이 파일을 .env 로 복사한 뒤 키를 채운다.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# .env 는 git 에 올라가지 않는다. 실제 키를 .env.example 에 적지 않는다.

# ── 필수 ────────────────────────────────────────────────────────────────────
# Gemini API 키. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── 선택 (기본값으로 동작한다) ──────────────────────────────────────────────
# 밖으로 열 포트. EC2 보안 그룹에서 이 포트를 열어야 한다.
#PUBLIC_PORT=80

# DB 접속 정보. 컨테이너 내부에서만 쓰이지만 운영에서는 바꾸는 것이 좋다.
#DB_NAME=naeil_study
#DB_USERNAME=postgres
#DB_PASSWORD=postgres

# AI 호출 방식. 배포에서는 gemini(compose 기본값), 로컬 개발은 mock 을 권장한다.
# mock 이면 분석·퀴즈가 목 데이터로 나오고 과금되지 않는다.
#LLM_MODE=gemini

#APP_TIMEZONE=Asia/Seoul
#LOG_LEVEL=INFO
